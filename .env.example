# Copy this file to .env, next to docker-compose.yml, and change the values.

# Time zone of the logs
TZ=Europe/Berlin

# The user and group that own what is written, and the rights of it (UMASK 022: others may read).
# They have to be a user the library may be written by. On an NFS share its settings decide.
PUID=1000
PGID=1000
UMASK=022

# The login. There is no way to use the web version without one.
HITOMI_USERNAME=admin
# Create the hash with:  docker run --rm -it ghcr.io/marcel1702/hitomi-downloader hash-password
# Keep the single quotes, they stop Docker Compose from reading the `$` as a variable.
HITOMI_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$replace-this-with-the-output-of-hash-password'

# The folder of the library on the Docker host, a placeholder to replace.
# If it is an NFS or SMB share, mount it on the host first. The containers do not start while
# this folder is missing.
LIBRARY_PATH=/path/to/the/library/on/the/host

# The port the web version is reached on
HITOMI_PORT=8080
