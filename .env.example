# Copy this file to .env, next to docker-compose.yml, and change the values.

# Time zone of the logs
TZ=Europe/Berlin

# The user and group that own what is written, and the rights of it (UMASK 022: others may read).
# They have to be a user the library and the export folder may be written by. On an NFS share its
# settings decide.
PUID=1000
PGID=1000
UMASK=022

# The login. There is no way to use the web version without one.
HITOMI_USERNAME=admin
# Create the hash with:  docker run --rm -it ghcr.io/marcel1702/hitomi-downloader hash-password
# Keep the single quotes, they stop Docker Compose from reading the `$` as a variable.
HITOMI_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$replace-this-with-the-output-of-hash-password'

# The folder of the library on the Docker host, a placeholder to replace.
# If it is an NFS or SMB share, mount it on the host first. The containers do not start while
# this folder is missing.
LIBRARY_PATH=/path/to/the/library/on/the/host

# The folder on the Docker host that "Export to server" writes the CBZ and PDF files to, a
# placeholder to replace. Not inside the library, a scan of it would list the comics twice. It has
# to exist as well.
EXPORT_PATH=/path/to/the/exports/on/the/host

# The port on the Docker host the web version is reached on (inside the container it is 8080)
HITOMI_PORT=8080

# Everything below is optional, leave it out unless you need it.

# How often the followed searches look for new galleries, in hours (default 6, 0: not by themselves)
# HITOMI_FOLLOW_INTERVAL_HOURS=6

# Behind a reverse proxy that serves https: the address you reach it under, and counting the failed
# logins per client instead of per proxy
# HITOMI_PUBLIC_URL=https://hitomi.example.com
# HITOMI_TRUST_FORWARDED_FOR=true

# How many days a login lasts (default 30)
# HITOMI_SESSION_DAYS=30

# Only if the library is on a file system with short file names, such as an encrypted shared folder
# of a Synology NAS (the server finds the limit out by itself)
# HITOMI_MAX_NAME_BYTES=143
